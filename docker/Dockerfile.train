# syntax=docker/dockerfile:1.7
# Training image: the full `forecast` CLI with torch, LightGBM, MLflow and ONNX export.
# Data, MLflow runs and results live outside the image; mount them (the run command is in the README).
ARG PYTHON_VERSION=3.12

FROM ghcr.io/astral-sh/uv:0.13.6 AS uv

FROM python:${PYTHON_VERSION}-slim AS build
COPY --from=uv /uv /usr/local/bin/uv
# `uv sync` (not `uv export`) so the lockfile's CPU-only torch index is honoured.
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy UV_PYTHON_DOWNLOADS=never UV_PROJECT_ENVIRONMENT=/opt/venv
WORKDIR /src
COPY pyproject.toml uv.lock README.md ./
RUN uv sync --frozen --no-dev --no-install-project --extra train --extra monitor
COPY src ./src
RUN uv sync --frozen --no-dev --no-editable --extra train --extra monitor

FROM python:${PYTHON_VERSION}-slim
# LightGBM needs the OpenMP runtime, which the slim image does not include.
RUN apt-get update  && apt-get install -y --no-install-recommends libgomp1  && rm -rf /var/lib/apt/lists/*
COPY --from=build /opt/venv /opt/venv
WORKDIR /app
COPY configs ./configs
ENV PATH=/opt/venv/bin:$PATH     FORECAST_ROOT=/app     PYTHONUNBUFFERED=1     PYTHONDONTWRITEBYTECODE=1
RUN useradd --uid 10001 --create-home --shell /usr/sbin/nologin app  && mkdir -p /app/data /app/mlruns /app/experiments /app/var  && chown -R app /app
USER 10001
ENTRYPOINT ["forecast"]
CMD ["--help"]
