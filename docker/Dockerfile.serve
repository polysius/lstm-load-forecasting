# syntax=docker/dockerfile:1.7
# Forecast API image. The same image runs locally (`docker run -p 8080:8080`) and on
# AWS Lambda, where the Lambda Web Adapter extension forwards Function URL requests
# to uvicorn. No torch, no pandas: numpy + onnxruntime + FastAPI only.
ARG PYTHON_VERSION=3.12

FROM ghcr.io/astral-sh/uv:0.13.6 AS uv

FROM python:${PYTHON_VERSION}-slim AS build
COPY --from=uv /uv /usr/local/bin/uv
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy
WORKDIR /src
COPY pyproject.toml uv.lock README.md ./
RUN uv export --frozen --no-dev --no-emit-project --extra serve --format requirements-txt \
        -o requirements.txt \
 && uv venv /opt/venv \
 && VIRTUAL_ENV=/opt/venv uv pip install --no-cache -r requirements.txt
COPY src ./src
RUN VIRTUAL_ENV=/opt/venv uv pip install --no-cache --no-deps .

FROM python:${PYTHON_VERSION}-slim
COPY --from=public.ecr.aws/awsguru/aws-lambda-adapter:1.1.0 /lambda-adapter /opt/extensions/lambda-adapter
COPY --from=build /opt/venv /opt/venv
# The bundle to serve: `forecast export` (registry) or `forecast smoke-bundle` (CI).
ARG MODEL_DIR=artifacts/model
COPY ${MODEL_DIR} /opt/model
ENV PATH=/opt/venv/bin:$PATH \
    MODEL_DIR=/opt/model \
    PORT=8080 \
    AWS_LWA_PORT=8080 \
    AWS_LWA_READINESS_CHECK_PATH=/health \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1
RUN useradd --uid 10001 --no-create-home --shell /usr/sbin/nologin app
USER 10001
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s \
  CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8080/health', timeout=2)"]
CMD ["uvicorn", "forecast.serve.app:app", "--host", "0.0.0.0", "--port", "8080", "--no-access-log"]
